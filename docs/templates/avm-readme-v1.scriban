{{~ func parameter_categories(items) ~}}
{{~ categories = ["Required", "Conditional", "Optional", "Generated", "Condition"] ~}}
{{~ for item in items ~}}
{{~ if item.description ~}}
{{~ prefix = regex.match item.description `^\w+\.` ~}}
{{~ if prefix.size > 0 ~}}
{{~ category = string.replace prefix[0] "." "" ~}}
{{~ if !(array.contains categories category) ~}}{{~ categories = array.add categories category ~}}{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ ret categories ~}}
{{~ end ~}}
{{~ func has_parameter(name) ~}}
{{~ for item in module.parameters ~}}
{{~ if item.name == name ~}}{{~ ret true ~}}{{~ end ~}}
{{~ end ~}}
{{~ ret false ~}}
{{~ end ~}}
{{~ func category_description(item, category, path) ~}}
{{~ if item.description == null ~}}{{~ ret "" ~}}{{~ end ~}}
{{~ text = regex.replace item.description ("^" + category + `\. `) "" ~}}
{{~ compiled = compiled_details[path] ~}}
{{~ if compiled && compiled.Description && (string.starts_with compiled.Description item.description) && !(string.ends_with item.description "\n") ~}}
{{~ suffix_matches = regex.match compiled.Description `(?:\r?\n)+$` ~}}
{{~ if suffix_matches.size > 0 ~}}{{~ text = text + suffix_matches[0] ~}}{{~ end ~}}
{{~ end ~}}
{{~ ret text | string.replace "\r\n" "<p>" | string.replace "\n- " "<li>" | string.replace "\n" "<p>" ~}}
{{~ end ~}}
{{~ func parameter_type(item, path) ~}}
{{~ if item.secure && item.type == "string" ~}}{{~ ret "securestring" ~}}{{~ end ~}}
{{~ if item.secure && item.type == "object" ~}}{{~ ret "secureObject" ~}}{{~ end ~}}
{{~ compiled = compiled_details[path] ~}}
{{~ if compiled && compiled.LegacyType != null ~}}{{~ ret compiled.LegacyType ~}}{{~ end ~}}
{{~ if compiled && compiled.Type != null ~}}{{~ ret compiled.Type ~}}{{~ end ~}}
{{~ ret item.type ~}}
{{~ end ~}}
{{~ func formatted_example(raw) ~}}
{{~ lines = string.split (string.replace raw "\r\n" "\n") "\n" ~}}
{{~ indent_matches = regex.match lines[0] `^\s+(?=.+)` ~}}
{{~ trim_count = 0 ~}}
{{~ if indent_matches.size > 0 ~}}{{~ trim_count = indent_matches[0].size ~}}{{~ end ~}}
{{~ formatted = "" ~}}
{{~ for line in lines ~}}
{{~ if line != "" ~}}
{{~ text = "  " + line ~}}
{{~ if trim_count > 0 ~}}{{~ text = regex.replace text (`^\s{` + trim_count + `}`) "" ~}}{{~ end ~}}
{{~ formatted = formatted + text + "\n" ~}}
{{~ end ~}}
{{~ end ~}}
{{~ ret string.rstrip formatted ~}}
{{~ end ~}}
{{~ func compiled_default_text(value, inner_indent, close_indent) ~}}
{{~ if value == null ~}}{{~ ret "null" ~}}{{~ end ~}}
{{~ kind = object.typeof value ~}}
{{~ if kind == "string" ~}}{{~ ret "'" + (string.replace value "'" `\'`) + "'" ~}}{{~ end ~}}
{{~ if kind == "boolean" || kind == "bool" ~}}{{~ if value ~}}{{~ ret "true" ~}}{{~ else ~}}{{~ ret "false" ~}}{{~ end ~}}{{~ end ~}}
{{~ if kind == "array" ~}}
{{~ if value.size == 0 ~}}{{~ ret "[]" ~}}{{~ end ~}}
{{~ scalar_items = true ~}}
{{~ for item in value ~}}
{{~ if (object.typeof item) == "object" || (object.typeof item) == "array" ~}}{{~ scalar_items = false ~}}{{~ end ~}}
{{~ end ~}}
{{~ ordered = value ~}}
{{~ if scalar_items && value.size > 1 ~}}{{~ ordered = array.sort value ~}}{{~ end ~}}
{{~ text = "[\n" ~}}
{{~ for item in ordered ~}}{{~ text = text + inner_indent + (compiled_default_text item (inner_indent + "  ") inner_indent) + "\n" ~}}{{~ end ~}}
{{~ ret text + close_indent + "]" ~}}
{{~ end ~}}
{{~ if kind == "object" ~}}
{{~ keys = (object.keys value) | array.sort ~}}
{{~ if keys.size == 0 ~}}{{~ ret "{}" ~}}{{~ end ~}}
{{~ text = "{\n" ~}}
{{~ for key in keys ~}}
{{~ property = key ~}}
{{~ if (regex.match key `^\w+$`).size == 0 ~}}{{~ property = "'" + (string.replace key "'" `\'`) + "'" ~}}{{~ end ~}}
{{~ text = text + inner_indent + property + ": " + (compiled_default_text value[key] (inner_indent + "  ") inner_indent) + "\n" ~}}
{{~ end ~}}
{{~ ret text + close_indent + "}" ~}}
{{~ end ~}}
{{~ ret value ~}}
{{~ end ~}}
{{~ func has_documented_parameters(items) ~}}
{{~ for child in items ~}}
{{~ if child.description ~}}
{{~ prefix = regex.match child.description `^\w+\. ` ~}}
{{~ if prefix.size > 0 ~}}{{~ ret true ~}}{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ ret false ~}}
{{~ end ~}}
{{~ func document_children(item, path) ~}}
{{~ compiled = compiled_details[path] ~}}
{{~ ret (has_documented_parameters item.properties) && !(compiled && !compiled.DocumentChildren) ~}}
{{~ end ~}}
{{~ func last_documented_parameter(items) ~}}
{{~ last = null ~}}
{{~ for category in (parameter_categories items) ~}}
{{~ for item in items ~}}
{{~ if item.description && (string.starts_with item.description (category + ". ")) ~}}
{{~ last = item ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ ret last ~}}
{{~ end ~}}
{{~ func renders_discriminator(item, path) ~}}
{{~ if !item.discriminator ~}}{{~ ret false ~}}{{~ end ~}}
{{~ compiled = compiled_details[path] ~}}
{{~ if compiled && ((!compiled.DocumentChildren) || (compiled.IsResourceDerived && !compiled.HasDiscriminator)) ~}}{{~ ret false ~}}{{~ end ~}}
{{~ ret true ~}}
{{~ end ~}}
{{~ func variant_cases(item, path) ~}}
{{~ compiled = compiled_details[path] ~}}
{{~ if !compiled || !compiled.VariantOrder || compiled.VariantOrder.size == 0 ~}}{{~ ret item.discriminator.cases ~}}{{~ end ~}}
{{~ if compiled.VariantOrder.size != item.discriminator.cases.size ~}}{{~ ret null ~}}{{~ end ~}}
{{~ ordered = [] ~}}
{{~ for value in compiled.VariantOrder ~}}
{{~ found = false ~}}
{{~ for variant in item.discriminator.cases ~}}
{{~ if variant.value == value ~}}{{~ ordered = array.add ordered variant ~}}{{~ found = true ~}}{{~ break ~}}{{~ end ~}}
{{~ end ~}}
{{~ if !found ~}}{{~ ret null ~}}{{~ end ~}}
{{~ end ~}}
{{~ ret ordered ~}}
{{~ end ~}}
{{~ func has_deep_discriminator(item, path) ~}}
{{~ if renders_discriminator item path ~}}
{{~ for variant in item.discriminator.cases ~}}
{{~ for child in variant.properties ~}}
{{~ child_path = path + "." + item.discriminator.propertyName + "-" + variant.value + "." + child.name ~}}
{{~ if (renders_discriminator child child_path) || (document_children child child_path) ~}}{{~ ret true ~}}{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ last_child = null ~}}
{{~ if document_children item path ~}}{{~ last_child = last_documented_parameter item.properties ~}}{{~ end ~}}
{{~ if last_child ~}}
{{~ child_path = path + "." + last_child.name ~}}
{{~ if (renders_discriminator last_child child_path) || (has_deep_discriminator last_child child_path) ~}}{{~ ret true ~}}{{~ end ~}}
{{~ end ~}}
{{~ ret false ~}}
{{~ end ~}}
{{~ func parameter_sections(items, parent, roles_in_scope) ~}}
{{~ rendered_details = 0 ~}}
{{~ previous_block_has_gap = false ~}}
{{~ for category in (parameter_categories items) ~}}
{{~ has_category = false ~}}
{{~ for item in items ~}}
{{~ if item.description && (string.starts_with item.description (category + ". ")) ~}}{{~ has_category = true ~}}{{~ end ~}}
{{~ end ~}}
{{ if has_category }}**{{ category }} parameters**

| Parameter | Type | Description |
| :-- | :-- | :-- |
{{ for item in items }}{{ if item.description && (string.starts_with item.description (category + ". ")) }}{{~ full_name = item.name ~}}{{~ if parent != "" ~}}{{~ full_name = parent + "." + item.name ~}}{{~ end ~}}| [`{{ item.name }}`](#parameter-{{ full_name | string.downcase | string.replace "." "" }}) | {{ parameter_type item full_name }} | {{ category_description item category full_name }} |
{{ end }}{{ end }}
{{ end }}{{ end }}{{~ for category in (parameter_categories items) ~}}
{{~ for item in items ~}}
{{~ if item.description && (string.starts_with item.description (category + ". ")) ~}}
{{~ full_name = item.name ~}}{{~ if parent != "" ~}}{{~ full_name = parent + "." + item.name ~}}{{~ end ~}}
{{~ parameter_info = compiled_details[full_name] ~}}
{{~ allowed_values = item.allowedValues ~}}
{{~ direct_values = null ~}}
{{~ if parent == "" && compiled_parameters[item.name] ~}}{{~ direct_values = compiled_parameters[item.name].allowedValues ~}}{{~ end ~}}
{{~ if parameter_info && parameter_info.AllowedValues.size == 0 ~}}{{~ allowed_values = [] ~}}{{~ end ~}}
{{~ if parameter_info && parameter_info.AllowedValues.size > 0 && ((direct_values && direct_values.size > 0) || item.allowedValues.size > 0 || parameter_info.AllowedValuesFromReference) ~}}{{~ allowed_values = parameter_info.AllowedValues ~}}{{~ end ~}}
{{~ allowed_header = "[" ~}}
{{~ if parent != "" && (regex.match item.name `^\w+$`).size == 0 ~}}{{~ allowed_header = "'" + (string.replace item.name "'" `\'`) + "': [" ~}}{{~ end ~}}
{{~ use_fenced_default = false ~}}
{{~ role_list = null ~}}
{{~ role_ambiguous = false ~}}
{{~ if item.name == "roleAssignments" && has_root_roles ~}}
{{~ role_list = roles_in_scope ~}}
{{~ if parent == "" ~}}
{{~ for entry in role_names ~}}
{{~ if entry.Identifier == "" ~}}{{~ role_list = entry.Names ~}}{{~ end ~}}
{{~ end ~}}
{{~ else ~}}
{{~ role_suffix = string.downcase (string.split parent ".")[0] ~}}
{{~ match_count = 0 ~}}
{{~ candidate_roles = null ~}}
{{~ conflicting_roles = false ~}}
{{~ for entry in role_names ~}}
{{~ role_identifier = string.downcase entry.Identifier ~}}
{{~ if role_identifier == role_suffix || string.ends_with role_identifier ("_" + role_suffix) ~}}
{{~ match_count = match_count + 1 ~}}
{{~ if candidate_roles == null ~}}{{~ candidate_roles = entry.Names ~}}
{{~ else if (object.to_json candidate_roles) != (object.to_json entry.Names) ~}}{{~ conflicting_roles = true ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ if match_count == 1 ~}}{{~ role_list = candidate_roles ~}}
{{~ else if match_count > 1 ~}}{{~ role_ambiguous = conflicting_roles ~}}{{~ role_list = null ~}}{{~ end ~}}
{{~ end ~}}
{{~ if role_list != null && !role_ambiguous ~}}{{~ roles_in_scope = role_list ~}}{{~ end ~}}
{{~ end ~}}{{ if rendered_details > 0 && !previous_block_has_gap }}{{ "\n" }}{{ end }}{{ rendered_details = rendered_details + 1 }}### Parameter: `{{ full_name }}`

