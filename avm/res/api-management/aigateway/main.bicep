metadata name = 'API Management AI Gateway'
metadata description = 'Deploys a standalone AI Gateway and its workspace-scoped model and tool configuration.'

import { managedIdentityAllType, roleAssignmentType, lockType } from 'br/public:avm/utl/types/avm-common-types:0.7.0'
import { apiKeyType as childApiKeyType } from './api-key/main.bicep'
import { workspaceType as childWorkspaceType } from './workspace/main.bicep'
import { modelProviderType as childModelProviderType, authenticationType as childAuthenticationType } from './workspace/model-provider/main.bicep'
import {
  modelType as childModelType
  policyType as childPolicyType
  tokenLimitPolicyType as childTokenLimitPolicyType
  costLimitPolicyType as childCostLimitPolicyType
  contentSafetyPolicyType as childContentSafetyPolicyType
} from './workspace/model-provider/model/main.bicep'
import { aliasType as childAliasType, routeType as childRouteType } from './workspace/alias/main.bicep'
import { toolServerType as childToolServerType, toolEndpointType as childToolEndpointType } from './workspace/tool-server/main.bicep'
import { telemetryExporterType as childTelemetryExporterType } from './workspace/telemetry-exporter/main.bicep'

@description('Required. The name of the AI Gateway. Use lowercase letters, numbers and hyphens.')
@minLength(3)
@maxLength(24)
param name string

@description('Optional. Azure region with AI Gateway preview availability.')
param location string = resourceGroup().location

@description('Optional. The only SKU accepted by the preview resource provider.')
param sku 'Premium' = 'Premium'

@description('Optional. Tags of the gateway.')
param tags { *: string } = {}

@description('Optional. Managed identities assigned to the gateway.')
param managedIdentities managedIdentityAllType = {
  systemAssigned: true
}

@description('Optional. Role assignments scoped to the gateway, not to upstream Foundry accounts.')
param roleAssignments roleAssignmentType[]?

@description('Optional. Resource lock applied after child configuration is deployed.')
param lock lockType?

@description('Optional. Enable AVM module usage telemetry. This is independent of runtime telemetry exporters.')
param enableTelemetry bool = true

@description('Optional. Virtual network configuration. Preview region and subnet requirements apply.')
param virtualNetworkConfiguration virtualNetworkConfigurationType?

@description('Optional. Gateway-level API keys. Key values are generated by the service unless secret references are supplied.')
param apiKeys apiKeyType[]?

@description('Optional. Workspace configuration. The service provisions default automatically; omit policies to reference it without a PUT.')
@maxLength(1)
param workspaces workspaceType[] = [
  {
    name: 'default'
  }
]

@secure()
@description('Optional. Secret values indexed by the secret names used in child configurations. Supply through secure parameters or Key Vault; never commit values.')
param secrets { *: string } = {}

var userAssignedIdentities = reduce(
  map(managedIdentities.?userAssignedResourceIds ?? [], id => { '${id}': {} }),
  {},
  (current, next) => union(current, next)
)
var identity = {
  type: (managedIdentities.?systemAssigned ?? false)
    ? (!empty(userAssignedIdentities) ? 'SystemAssigned,UserAssigned' : 'SystemAssigned')
    : (!empty(userAssignedIdentities) ? 'UserAssigned' : 'None')
  userAssignedIdentities: userAssignedIdentities
}

var builtInRoleNames = {
  Contributor: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')
  Owner: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '8e3af657-a8ff-443c-a75c-2fe8c4bcb635')
  Reader: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')
  'Role Based Access Control Administrator': subscriptionResourceId(
    'Microsoft.Authorization/roleDefinitions',
    'f58310d9-a9f6-439a-9e8d-f62e7b41a168'
  )
  'User Access Administrator': subscriptionResourceId(
    'Microsoft.Authorization/roleDefinitions',
    '18d7d88d-d35e-4fb5-a5c3-7773c20a72d9'
  )
}
var formattedRoleAssignments = [
  for assignment in (roleAssignments ?? []): union(assignment, {
    roleDefinitionId: builtInRoleNames[?assignment.roleDefinitionIdOrName] ?? (contains(
        assignment.roleDefinitionIdOrName,
        '/providers/Microsoft.Authorization/roleDefinitions/'
      )
      ? assignment.roleDefinitionIdOrName
      : subscriptionResourceId('Microsoft.Authorization/roleDefinitions', assignment.roleDefinitionIdOrName))
  })
]

var telemetryIdPrefix = loadJsonContent('metadata.json', 'telemetryIdPrefix')

#disable-next-line no-deployments-resources
resource avmTelemetry 'Microsoft.Resources/deployments@2025-04-01' = if (enableTelemetry) {
  name: '${telemetryIdPrefix}.${replace('-..--..-', '.', '-')}.${substring(uniqueString(deployment().name, location), 0, 4)}'
  properties: {
    mode: 'Incremental'
    template: {
      '$schema': 'https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#'
      contentVersion: '1.0.0.0'
      resources: []
      outputs: {
        telemetry: {
          type: 'String'
          value: 'For more information, see https://aka.ms/avm/TelemetryInfo'
        }
      }
    }
  }
}

// The preview type is not yet in Bicep's resource type catalog; inputs are explicitly typed below.
#disable-next-line BCP081
resource gateway 'Microsoft.ApiManagement/aigateways@2025-09-01-preview' = {
  name: name
  location: location
  tags: tags
  sku: {
    name: sku
  }
  identity: identity
  properties: virtualNetworkConfiguration == null
    ? {}
    : {
        virtualNetworkType: virtualNetworkConfiguration!.virtualNetworkType
        virtualNetworkConfiguration: {
          subnetResourceId: virtualNetworkConfiguration!.subnetResourceId
        }
      }
}

module gateway_apiKeys './api-key/main.bicep' = [
  for (apiKey, index) in (apiKeys ?? []): {
    name: '${uniqueString(deployment().name, location)}-ApiKey-${index}'
    params: {
      aiGatewayName: gateway.name
      name: apiKey.name
      properties: apiKey.?properties ?? {}
      secrets: secrets
    }
  }
]

module gateway_workspaces './workspace/main.bicep' = [
  for (workspace, index) in workspaces: {
    name: '${uniqueString(deployment().name, location)}-Workspace-${index}'
    params: {
      aiGatewayName: gateway.name
      name: workspace.name
      policies: workspace.?policies
      modelProviders: workspace.?modelProviders
      aliases: workspace.?aliases
      toolServers: workspace.?toolServers
      telemetryExporters: workspace.?telemetryExporters
      secrets: secrets
    }
    dependsOn: [
      gateway_apiKeys
    ]
  }
]

resource gateway_roleAssignments 'Microsoft.Authorization/roleAssignments@2022-04-01' = [
  for assignment in formattedRoleAssignments: {
    name: assignment.?name ?? guid(gateway.id, assignment.principalId, assignment.roleDefinitionId)
    scope: gateway
    properties: {
      roleDefinitionId: assignment.roleDefinitionId
      principalId: assignment.principalId
      principalType: assignment.?principalType
      description: assignment.?description
      condition: assignment.?condition
      conditionVersion: !empty(assignment.?condition) ? (assignment.?conditionVersion ?? '2.0') : null
      delegatedManagedIdentityResourceId: assignment.?delegatedManagedIdentityResourceId
    }
  }
]

resource gateway_lock 'Microsoft.Authorization/locks@2020-05-01' = if (contains(
  ['CanNotDelete', 'ReadOnly'],
  lock.?kind ?? 'None'
)) {
  name: lock.?name ?? 'lock-${name}'
  scope: gateway
  properties: {
    level: lock.?kind ?? ''
    notes: lock.?notes ?? (lock.?kind == 'CanNotDelete'
      ? 'Cannot delete resource or child resources.'
      : 'Cannot delete or modify the resource or child resources.')
  }
  dependsOn: [
    gateway_apiKeys
    gateway_workspaces
    gateway_roleAssignments
  ]
}

@description('The resource ID of the gateway.')
output resourceId string = gateway.id
@description('The name of the gateway.')
output name string = gateway.name
@description('The resource group containing the gateway.')
output resourceGroupName string = resourceGroup().name
@description('The region of the gateway.')
output location string = gateway.location
@description('The system-assigned managed identity principal ID, or null when not enabled.')
output systemAssignedMIPrincipalId string? = gateway.?identity.?principalId
@description('The service-provided default runtime hostname.')
output defaultHostname string = gateway.properties.frontend.defaultHostname
@description('The IDs of the configured API keys. Secret values are never output.')
output apiKeyResourceIds string[] = [for (apiKey, index) in (apiKeys ?? []): gateway_apiKeys[index].outputs.resourceId]
@description('The IDs of the configured workspaces.')
output workspaceResourceIds string[] = [
  for (workspace, index) in workspaces: gateway_workspaces[index].outputs.resourceId
]

@export()
@description('Gateway-level API key configuration.')
type apiKeyType = childApiKeyType
@export()
@description('Workspace configuration and its nested resources.')
type workspaceType = childWorkspaceType
@export()
@description('Model provider configuration and catalog models.')
type modelProviderType = childModelProviderType
@export()
@description('Provider authentication with secure input references.')
type authenticationType = childAuthenticationType
@export()
@description('Catalog model configuration.')
type modelType = childModelType
@export()
@description('Supported inline model and workspace policies.')
type policyType = childPolicyType
@export()
@description('Token budget policy.')
type tokenLimitPolicyType = childTokenLimitPolicyType
@export()
@description('Cost budget policy.')
type costLimitPolicyType = childCostLimitPolicyType
@export()
@description('Content safety thresholds.')
type contentSafetyPolicyType = childContentSafetyPolicyType
@export()
@description('Client-facing model alias configuration.')
type aliasType = childAliasType
@export()
@description('An alias route to a provider model.')
type routeType = childRouteType
@export()
@description('MCP or OpenAPI tool server configuration.')
type toolServerType = childToolServerType
@export()
@description('A tool server upstream endpoint.')
type toolEndpointType = childToolEndpointType
@export()
@description('Application Insights or OpenTelemetry exporter configuration.')
type telemetryExporterType = childTelemetryExporterType
@export()
@sealed()
@description('Gateway virtual network attachment.')
type virtualNetworkConfigurationType = {
  virtualNetworkType: 'External' | 'Internal'
  subnetResourceId: string
}
