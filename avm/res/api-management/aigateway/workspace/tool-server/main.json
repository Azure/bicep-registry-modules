        "path": "[tryGet(parameters('properties'), 'path')]",
        "subscriptionRequired": "[coalesce(tryGet(parameters('properties'), 'subscriptionRequired'), true())]",
        "allowList": "[tryGet(parameters('properties'), 'allowList')]",
        "blocked": "[tryGet(parameters('properties'), 'blocked')]"
