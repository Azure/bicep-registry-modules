  "resources": {
    "workspace": {
      "existing": true,
      "type": "Microsoft.ApiManagement/aigateways/workspaces",
      "apiVersion": "2025-09-01-preview",
      "name": "[format('{0}/{1}', parameters('aiGatewayName'), parameters('workspaceName'))]"
    },
    "alias": {
      "type": "Microsoft.ApiManagement/aigateways/workspaces/aliases",
      "apiVersion": "2025-09-01-preview",
      "name": "[format('{0}/{1}/{2}', split(format('{0}/{1}', parameters('aiGatewayName'), parameters('workspaceName')), '/')[0], split(format('{0}/{1}', parameters('aiGatewayName'), parameters('workspaceName')), '/')[1], parameters('name'))]",
      "properties": {
        "copy": [
          {
            "name": "routes",
            "count": "[length(parameters('properties').routes)]",
            "input": {
              "providerName": "[parameters('properties').routes[copyIndex('routes')].providerName]",
              "modelName": "[parameters('properties').routes[copyIndex('routes')].modelName]",
              "priority": "[coalesce(tryGet(parameters('properties').routes[copyIndex('routes')], 'priority'), 0)]",
              "weight": "[coalesce(tryGet(parameters('properties').routes[copyIndex('routes')], 'weight'), 1)]"
            }
          }
        ],
        "displayName": "[parameters('properties').displayName]",
        "description": "[tryGet(parameters('properties'), 'description')]",
        "policies": "[tryGet(parameters('properties'), 'policies')]"
      }
    }
  },
